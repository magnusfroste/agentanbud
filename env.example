# Agentanbud — example env values for Easypanel
#
# All values shown are defaults — only set what you want to override.

# --- Network (Traefik handles HTTPS, this is for the container's own port) ---
APP_PORT=8080
APP_BIND=0.0.0.0

# --- Database ---
# Inside the container. Persisted in the ./data volume.
DB_PATH=/data/application.db

# --- Scraping ---
# Sent to Mercell / TED with every request. Be polite — they may rate-limit.
USER_AGENT=agentanbud/0.1 https://github.com/magnusfroste/agentanbud

# Schedule (any valid crontab expression). Default: 06:00 daily.
CRON_SCHEDULE=0 6 * * *

# Toggle individual sources. Set to "false" to skip.
SCRAPE_MERCELL=true
SCRAPE_TED=true
SCRAPE_TED_AWARDS=true
SCRAPE_TED_PIN=true
SCRAPE_LOV=true
SCRAPE_KOMMERSANNONS=true
SCRAPE_CRITERIA=true
SCRAPE_QUESTIONS=true
LOG_LEVEL=INFO

# --- Synonyms learned at night (scraper/synonyms.py) ---
# An OpenAI-compatible API. Off unless all three are set. Put the key in the
# environment only, never in the repository.
# LLM_BASE_URL=https://example.invalid/v1
# LLM_API_KEY=
# LLM_MODEL=
# auto (default): search with every suggestion that passes the checks at once;
# an agent reviews them over MCP (list_synonyms, review_synonym) or on
# /ops/synonymer. suggest: wait for someone to approve each one.
# LLM_SYNONYMS_MODE=auto
# LLM_SYNONYMS_PER_NIGHT=15
